# Optional environment variables for advanced AI tooling.
# Leave blank for the free FutureIndustries path (procedural art + make-sfx.py).
# Never commit real keys. Never put keys inside Arcade upload zips.

# Image generation (bulk art pipelines)
# XAI_API_KEY=

# 3D generation
# MESHY_API_KEY=
# HYPER3D_API_KEY=

# Design / style platforms
# FIGMA_PERSONAL_ACCESS_TOKEN=
# SCENARIO_API_KEY=

# Audio (premium path — free pack uses tools/make-sfx.py instead)
# ELEVENLABS_API_KEY=

# Docs MCP
# CONTEXT7_API_KEY=
