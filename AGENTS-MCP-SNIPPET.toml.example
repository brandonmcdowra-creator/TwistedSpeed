# Optional MCP snippets for Grok Build (~/.grok/config.toml)
# Copy sections you want. Do NOT commit real API keys.
# Pack works with zero MCP servers.

# --- Free: browser eyes (recommended for BUILD-CHECK) ---
[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@latest"]
enabled = true

# --- Free-ish: up-to-date docs ---
[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
enabled = true
# headers = { "CONTEXT7_API_KEY" = "YOUR_KEY_IF_NEEDED" }

